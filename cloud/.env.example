# Copy to .env.local for local development. On Vercel, set the same names under Project Settings > Environment Variables.
# Supabase values are in the dashboard under Project Settings > API Keys (and Data API for the URL).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...). Public by design: row-level security only lets signed-in users read.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...). Server-only: never prefix it with NEXT_PUBLIC_ and never paste it anywhere public.
SUPABASE_SECRET_KEY=
# Projects on the older JWT keys can use NEXT_PUBLIC_SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY instead.

# SerpAPI key (https://serpapi.com/manage-api-key). Server-only.
SERPAPI_KEY=

# Tests only: point the search at a fake SerpAPI. Leave unset in production.
# SERPAPI_BASE_URL=http://127.0.0.1:4010/search
